from itertools import permutations, product
from math import factorial

MOD = 998244353

def solve_brute(n, edges):
    """Count total schedules summed over all flexible edge orientations."""
    flex_count = sum(1 for _,_,w in edges if w == 0)
    total = 0
    for orient in product([True, False], repeat=flex_count):
        # Build DAG
        adj = [[] for _ in range(n+1)]
        flex_idx = 0
        for u, v, w in edges:
            if w == 1:
                adj[u].append(v)
            elif w == 2:
                adj[v].append(u)
            else:
                if orient[flex_idx]:
                    adj[u].append(v)
                else:
                    adj[v].append(u)
                flex_idx += 1
        
        # Count topological orderings
        count = 0
        for perm in permutations(range(1, n+1)):
            pos = {perm[i]: i for i in range(n)}
            valid = True
            for u in range(1, n+1):
                for v in adj[u]:
                    if pos[u] >= pos[v]:
                        valid = False
                        break
                if not valid:
                    break
            if valid:
                count += 1
        total += count
    return total % MOD

def solve_formula(n, edges):
    """My hook length formula approach."""
    adj = [[] for _ in range(n+1)]
    outdeg = [0] * (n+1)
    for u, v, w in edges:
        if w == 1:
            adj[u].append(v); adj[v].append(u); outdeg[u] += 1
        elif w == 2:
            adj[v].append(u); adj[u].append(v); outdeg[v] += 1
    
    visited = [False] * (n+1)
    sz = [0] * (n+1)
    
    def dfs(u, p):
        visited[u] = True
        sz[u] = 1
        for v in adj[u]:
            if v == p or visited[v]: continue
            dfs(v, u)
            sz[u] += sz[v]
    
    for i in range(1, n+1):
        if not visited[i] and outdeg[i] == 0:
            dfs(i, -1)
    
    for i in range(1, n+1):
        if not visited[i]: sz[i] = 1
    
    fact = 1
    for i in range(1, n+1): fact = fact * i % MOD
    prod = 1
    for i in range(1, n+1): prod = prod * sz[i] % MOD
    
    return fact * pow(prod, MOD-2, MOD) % MOD

# Test cases
# Test 1: n=3, tree 1-2-3, all flexible
edges = [(1,2,0), (2,3,0)]
print(f"n=3 all flex: brute={solve_brute(3, edges)}, formula={solve_formula(3, edges)}")

# Test 2: n=4, path 1-2-3-4, all flexible
edges = [(1,2,0), (2,3,0), (3,4,0)]
print(f"n=4 path all flex: brute={solve_brute(4, edges)}, formula={solve_formula(4, edges)}")

# Test 3: n=4, star centered at 2, all flexible
edges = [(1,2,0), (2,3,0), (2,4,0)]
