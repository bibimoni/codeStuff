# Verify the self-crossing examples
# Test 1: 2 1 1 2 -> Yes (4th segment intersects 1st)
# Test 2: 1 2 3 4 -> No
# Test 3: 1 1 1 1 1 -> Yes (4th returns to origin)

# Directions: N, W, S, E (0,1,2,3)
# N: y++, W: x--, S: y--, E: x++
# Standard spiral self-crossing algorithm

def check(d):
    n = len(d)
    # Compute path points
    x, y = 0, 0
    pts = [(x, y)]
    dx = [0, -1, 0, 1]
    dy = [1, 0, -1, 0]
    for i in range(n):
        x += dx[d[i]] * d[i]
        y += dy[d[i]] * d[i]
        pts.append((x, y))
    
    # Check all non-consecutive segment pairs
    for i in range(n):
        for j in range(i-2, -1, -1):
            if i - j <= 1: continue
            # Segment i: pts[i] to pts[i+1], Segment j: pts[j] to pts[j+1]
            # But actually, segment k goes from pts[k] to pts[k+1]
            s1x1, s1y1 = pts[i]
            s1x2, s1y2 = pts[i+1]
            s2x1, s2y1 = pts[j]
            s2x2, s2y2 = pts[j+1]
            
            # Axis-aligned segments
            if s1x1 == s1x2:  # vertical
                vx, vy1, vy2 = s1x1, min(s1y1, s1y2), max(s1y1, s1y2)
                if s2y1 == s2y2:  # horizontal
                    hy, hx1, hx2 = s2y1, min(s2x1, s2x2), max(s2x1, s2x2)
                    if hx1 <= vx <= hx2 and vy1 <= hy <= vy2:
                        # Check if they share only endpoints (consecutive segments)
                        if j+1 != i and i+1 != j:  # not consecutive
                            return True
                else:  # both vertical
                    if vx == s2x1 and max(vy1, min(s2y1, s2y2)) <= min(vy2, max(s2y1, s2y2)):
                        if j+1 != i and i+1 != j:
                            return True
            else:  # horizontal
                hy, hx1, hx2 = s1y1, min(s1x1, s1x2), max(s1x1, s1x2)
                if s2x1 == s2x2:  # vertical
                    vx, vy1, vy2 = s2x1, min(s2y1, s2y2), max(s2y1, s2y2)
                    if hx1 <= vx <= hx2 and vy1 <= hy <= vy2:
                        if j+1 != i and i+1 != j:
                            return True
                else:  # both horizontal
                    if hy == s2y1 and max(hx1, min(s2x1, s2x2)) <= min(hx2, max(s2x1, s2x2)):
                        if j+1 != i and i+1 != j:
                            return True
    return False

print('Test 1:', check([2,1,1,2]))
print('Test 2:', check([1,2,3,4]))
print('Test 3:', check([1,1,1,1,1]))
"

