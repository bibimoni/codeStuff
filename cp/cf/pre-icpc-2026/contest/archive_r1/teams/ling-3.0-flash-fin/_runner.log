# Test 4: n=4, path with one fixed edge
edges = [(1,2,1), (2,3,0), (3,4,0)]
print(f"n=4 path 1 fixed: brute={solve_brute(4, edges)}, formula={solve_formula(4, edges)}")

# Test 5: n=5, problem example
edges = [(1,2,2), (1,3,0), (3,5,1), (3,4,2)]
