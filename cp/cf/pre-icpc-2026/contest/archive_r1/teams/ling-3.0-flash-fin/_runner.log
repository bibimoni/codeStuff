from itertools import permutations, product

def count_for_orientation(n, edges, orientation):
    # edges: list of (u, v, type) where type 1 means u->v, type 2 means v->u, type 0 means flexible
    # orientation: list of booleans for flexible edges (True = u->v, False = v->u)
    # Returns number of topological orderings
    
    # Build adjacency (directed)
    adj = [[] for _ in range(n+1)]
    in_deg = [0] * (n+1)
    
    flex_idx = 0
    for u, v, w in edges:
        if w == 1:
            adj[u].append(v)
            in_deg[v] += 1
        elif w == 2:
            adj[v].append(u)
            in_deg[u] += 1
        else:  # flexible
            if orientation[flex_idx]:
                adj[u].append(v)
                in_deg[v] += 1
            else:
                adj[v].append(u)
                in_deg[u] += 1
            flex_idx += 1
    
    # Count topological orderings
    count = 0
    for perm in permutations(range(1, n+1)):
        pos = {perm[i]: i for i in range(n)}
        valid = True
        for u in range(1, n+1):
            for v in adj[u]:
                if pos[u] >= pos[v]:
                    valid = False
                    break
            if not valid:
                break
        if valid:
            count += 1
    return count

