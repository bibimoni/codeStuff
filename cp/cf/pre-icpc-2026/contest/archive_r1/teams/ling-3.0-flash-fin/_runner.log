#include <bits/stdc++.h>
using namespace std;

const int MOD = 998244353;

long long power(long long base, long long exp, long long mod) {
    long long result = 1;
    base %= mod;
    while (exp > 0) {
        if (exp & 1) result = result * base % mod;
        base = base * base % mod;
        exp >>= 1;
    }
    return result;
}

int main(){
    int n;
    scanf("%d", &n);
    
    vector<vector<int>> dir_adj(n+1);
    vector<int> indeg(n+1, 0);
    
    for (int i = 0; i < n-1; i++) {
        int u, v, w;
        scanf("%d%d%d", &u, &v, &w);
        if (w == 1) {
            dir_adj[u].push_back(v);
            indeg[v]++;
        } else if (w == 2) {
            dir_adj[v].push_back(u);
            indeg[u]++;
        }
    }
    
    queue<int> q;
    vector<int> indeg_copy = indeg;
    for (int i = 1; i <= n; i++) {
        if (indeg_copy[i] == 0) q.push(i);
    }
    vector<int> topo;
    while (!q.empty()) {
        int u = q.front(); q.pop();
        topo.push_back(u);
        for (int v : dir_adj[u]) {
            if (--indeg_copy[v] == 0) q.push(v);
        }
    }
    
    if ((int)topo.size() != n) {
        printf("0\n");
        return 0;
    }
    
    vector<long long> sz(n+1, 1);
    for (int i = n-1; i >= 0; i--) {
        int u = topo[i];
        for (int v : dir_adj[u]) {
            sz[u] += sz[v];
        }
    }
    
    long long fact = 1;
    for (int i = 1; i <= n; i++) fact = fact * i % MOD;
    
    long long prod = 1;
    for (int i = 1; i <= n; i++) prod = prod * sz[i] % MOD;
    
    long long ans = fact % MOD * power(prod, MOD - 2, MOD) % MOD;
    printf("%lld\n", ans);
    return 0;
}
