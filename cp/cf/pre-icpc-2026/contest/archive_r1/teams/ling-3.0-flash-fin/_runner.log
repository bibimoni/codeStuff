from functools import lru_cache

# win(p, n) = True if current player wins with current product p and target n
@lru_cache(maxsize=None)
def win(p, n):
    if p * 9 >= n:
        return True
    for k in range(2, 10):
        np = p * k
        if np < n and not win(np, n):
            return True
    return False

# For initial state p=1
results = []
for n in range(1, 200):
    if not win(1, n):
        results.append(n)
print('Losing positions for first player:', results)
