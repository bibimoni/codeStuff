#include <bits/stdc++.h>
using namespace std;
typedef long long ll;
const ll INF = 1e18;

// Segment tree with lazy propagation for range add, range min
struct SegTree {
    int n;
    vector<ll> tree, lazy;
    SegTree() : n(0) {}
    SegTree(int n) : n(n), tree(4*n, INF), lazy(4*n, 0) {}
    
    void push(int node) {
        if (lazy[node]) {
            tree[2*node] += lazy[node];
            lazy[2*node] += lazy[node];
            tree[2*node+1] += lazy[node];
            lazy[2*node+1] += lazy[node];
            lazy[node] = 0;
        }
    }
    
    void update(int node, int lo, int hi, int l, int r, ll val) {
        if (r < lo || hi < l) return;
        if (l <= lo && hi <= r) {
            tree[node] += val;
            lazy[node] += val;
            return;
        }
        push(node);
        int mid = (lo + hi) / 2;
        update(2*node, lo, mid, l, r, val);
        update(2*node+1, mid+1, hi, l, r, val);
        tree[node] = min(tree[2*node], tree[2*node+1]);
    }
    
    void update(int l, int r, ll val) { update(1, 1, n, l, r, val); }
    
    ll query(int node, int lo, int hi, int l, int r) {
        if (r < lo || hi < l) return INF;
        if (l <= lo && hi <= r) return tree[node];
        push(node);
        int mid = (lo + hi) / 2;
        return min(query(2*node, lo, mid, l, r), query(2*node+1, mid+1, hi, l, r));
    }
    
    ll query(int l, int r) { return query(1, 1, n, l, r); }
    
    void set(int pos, ll val) {
        // Point set: need to compute the delta
        ll cur = query(pos, pos);
        update(pos, pos, val - cur);
    }
};

// Fenwick tree for prefix sums
struct Fenwick {
    int n;
    vector<ll> bit;
    Fenwick(int n) : n(n), bit(n+1, 0) {}
    void update(int i, ll delta) { for (; i <= n; i += i&(-i)) bit[i] += delta; }
    ll query(int i) { ll s = 0; for (; i > 0; i -= i&(-i)) s += bit[i]; return s; }
};

int main(){
    int t;
    scanf("%d", &t);
    while (t--) {
        int n, q;
        scanf("%d%d", &n, &q);
        
        vector<ll> a(n+1), b(n+1);
        for (int i = 1; i <= n; i++) scanf("%lld", &a[i]);
        for (int i = 1; i <= n; i++) scanf("%lld", &b[i]);
        
        // Prefix sums
        Fenwick fenw(n);
        for (int i = 1; i <= n; i++) fenw.update(i, a[i]);
        
        auto getQ = [&](int i) -> ll {
            if (i <= 0) return 0;
            return fenw.query(i);
        };
        
        ll total = getQ(n);
        
        // Segment trees
        SegTree segA(n), segB(n);
        
        auto init = [&]() {
            for (int i = 1; i <= n; i++) {
                ll qim1 = getQ(i-1);
                segA.set(i, qim1 + b[i]);
                segB.set(i, -qim1 + b[i]);
            }
        };
        init();
        
        auto getCW = [&](int s, int t) -> ll {
            if (s == t) return 0;
            if (t > s) return getQ(t-1) - getQ(s-1);
            return total - getQ(s-1) + getQ(t-1);
        };
        
        auto getCCW = [&](int s, int t) -> ll {
            return total - getCW(s, t);
        };
        
        while (q--) {
            int type;
            scanf("%d", &type);
            if (type == 1) {
                int s, tt;
                scanf("%d%d", &s, &tt);
                if (tt == n+1) {
                    // s island, t = Nook
                    ll ans = b[s];
                    // Direct flight
                    // Through Nook with ring detour
                    // For all i, ring(s,i) + b[i]
                    // CW(s,i) + b[i] = valA[i] - Q[s-1]
                    // CCW(s,i) + b[i]: depends on i vs s
                    
                    // For i != s:
                    // CW(s,i) + b[i] = valA[i] - Q[s-1]
                    // CCW(s,i) + b[i] = Q[s-1] + b[i] + (i > s ? total : 0) - Q[i-1] + Q[i-1]... 
                    // Actually CCW(s,i) + b[i]:
                    // i < s: Q[s-1] + valB[i]
                    // i > s: Q[s-1] + total + valB[i]
                    // i = s: b[s]
                    
                    // So ring(s,i) + b[i] = min(CW+b[i], CCW+b[i])
                    // For i < s: min(valA[i] - Q[s-1], Q[s-1] + valB[i])
                    // For i > s: min(valA[i] - Q[s-1], Q[s-1] + total + valB[i])
                    // For i = s: b[s]
                    
                    // Overall min:
                    ll min_val = INF;
                    
                    if (s > 1) {
                        ll mA = segA.query(1, s-1);
                        ll mB = segB.query(1, s-1);
                        min_val = min(min_val, -getQ(s-1) + mA);
                        min_val = min(min_val, getQ(s-1) + mB);
                    }
                    if (s < n) {
                        ll mA = segA.query(s+1, n);
                        ll mB = segB.query(s+1, n);
                        min_val = min(min_val, -getQ(s-1) + mA);
                        min_val = min(min_val, getQ(s-1) + total + mB);
                    }
                    min_val = min(min_val, b[s]);
                    
                    ans = min(ans, min_val);
                    printf("%lld\n", ans);
                } else {
                    // Both islands
                    int t = tt;
                    ll cw = getCW(s, t);
                    ll ccw = getCCW(s, t);
                    ll direct = b[s] + b[t];
                    
                    // Nook detour path 4: s -> CW -> i -> Nook -> j -> CCW -> t
                    // i on CW arc [s, t-1], j on CCW arc [t, n] ∪ [1, s-1]
                    ll path4 = INF;
                    if (s < t - 1) { // CW arc has nodes
                        ll mA_cw = segA.query(s, t-1);
                        ll path4_part1 = -getQ(s-1) + mA_cw;
                        
                        // CCW arc split: [t, n] and [1, s-1]
                        ll mA_ccw1 = (t <= n) ? segA.query(t, n) : INF;
                        ll mA_ccw2 = (s > 1) ? segA.query(1, s-1) : INF;
                        ll path4_ccw = min(-getQ(t-1) + mA_ccw1, total + getQ(t-1) + mA_ccw2);
                        
                        path4 = path4_part1 + path4_ccw;
                    }
                    
                    // Nook detour path 5: s -> CCW -> i -> Nook -> j -> CW -> t
                    // i on CCW arc, j on CW arc [s, t-1]
                    ll path5 = INF;
                    {
                        // CCW arc split: [t, n] and [1, s-1]
                        ll mB_ccw1 = (t <= n) ? segB.query(t, n) : INF;
                        ll mB_ccw2 = (s > 1) ? segB.query(1, s-1) : INF;
                        ll path5_ccw = getQ(s-1) + min(mB_ccw1, mB_ccw2);
                        
                        // CW arc
                        ll mB_cw = segB.query(s, t-1);
                        ll path5_cw = getQ(t-1) + mB_cw;
                        
                        path5 = path5_ccw + path5_cw;
                    }
                    
                    ll ans = min({cw, ccw, direct, path4, path5});
                    printf("%lld\n", ans);
                }
            } else if (type == 2) {
                int x; ll w;
                scanf("%d%lld", &x, &w);
                ll delta = w - a[x];
                a[x] = w;
                fenw.update(x, delta);
                total += delta;
                // Update segA and segB for indices x+1 to n
                if (x + 1 <= n) {
                    segA.update(x+1, n, delta);
                    segB.update(x+1, n, -delta);
                }
            } else {
                int x; ll w;
                scanf("%d%lld", &x, &w);
                ll qim1 = getQ(x-1);
                b[x] = w;
                segA.set(x, qim1 + w);
                segB.set(x, -qim1 + w);
            }
        }
    }
    return 0;
}
