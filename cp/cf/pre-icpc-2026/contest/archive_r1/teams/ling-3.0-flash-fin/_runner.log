#include <bits/stdc++.h>
using namespace std;

int n;
vector<tuple<int,int,int>> edges; // u, v, w

// Count linear extensions of a directed graph
long long countLE(vector<vector<int>>& adj, vector<int>& indeg) {
    // Use DP over subsets
    vector<long long> dp(1<<n, 0);
    dp[0] = 1;
    for (int mask = 0; mask < (1<<n); mask++) {
        if (dp[mask] == 0) continue;
        for (int v = 0; v < n; v++) {
            if (mask & (1<<v)) continue;
            // Check if all predecessors of v are in mask
            bool ok = true;
            for (int u = 0; u < n; u++) {
                if (adj[u][v] && !(mask & (1<<u))) {
                    ok = false; break;
                }
            }
            if (ok) dp[mask | (1<<v)] += dp[mask];
        }
    }
    return dp[(1<<n)-1];
}

int main(){
    // Test with example: n=5, edges: (1,2,2), (1,3,0), (3,5,1), (3,4,2)
    n = 5;
    edges = {{0,1,2}, {0,2,0}, {2,4,1}, {2,3,2}}; // 0-indexed
    
    long long total = 0;
    // Enumerate all orientations of flexible edges
    // Flexible edges are those with w=0
    vector<int> flex_indices;
    for (int i = 0; i < n-1; i++) {
        if (get<2>(edges[i]) == 0) flex_indices.push_back(i);
    }
    
    int num_flex = flex_indices.size();
    for (int mask = 0; mask < (1<<num_flex); mask++) {
        // Build directed graph
        vector<vector<int>> adj(n, vector<int>(n, 0));
        vector<int> indeg(n, 0);
        for (int i = 0; i < n-1; i++) {
            auto [u, v, w] = edges[i];
            if (w == 1) {
                adj[u][v] = 1;
                indeg[v]++;
            } else if (w == 2) {
                adj[v][u] = 1;
                indeg[u]++;
            } else {
                // Flexible edge
                int fi = -1;
                for (int j = 0; j < num_flex; j++) {
                    if (flex_indices[j] == i) { fi = j; break; }
                }
                if (mask & (1<<fi)) {
                    // u -> v
                    adj[u][v] = 1;
                    indeg[v]++;
                } else {
                    // v -> u
                    adj[v][u] = 1;
                    indeg[u]++;
                }
            }
        }
        long long le = countLE(adj, indeg);
        total += le;
    }
    printf("Brute force: %lld\n", total);
    
    // Also compute using hook length formula
    // Fixed poset: build directed graph
    vector<vector<int>> fadj(n, vector<int>(n, 0));
    vector<int> findeg(n, 0);
    for (int i = 0; i < n-1; i++) {
        auto [u, v, w] = edges[i];
        if (w == 1) { fadj[u][v] = 1; findeg[v]++; }
        else if (w == 2) { fadj[v][u] = 1; findeg[u]++; }
    }
    
    // Topological sort
    queue<int> q;
    vector<int> indeg_cp = findeg;
    for (int i = 0; i < n; i++) if (indeg_cp[i] == 0) q.push(i);
    vector<int> topo;
    while (!q.empty()) {
        int u = q.front(); q.pop();
        topo.push_back(u);
        for (int v = 0; v < n; v++) if (fadj[u][v] && --indeg_cp[v] == 0) q.push(v);
    }
    
    vector<int> sz(n, 1);
    for (int i = n-1; i >= 0; i--) {
        int u = topo[i];
        for (int v = 0; v < n; v++) if (fadj[u][v]) sz[u] += sz[v];
    }
    
    long long fact = 1;
    for (int i = 1; i <= n; i++) fact *= i;
    long long prod = 1;
    for (int i = 0; i < n; i++) prod *= sz[i];
    long long hl_ans = fact / prod;
    printf("Hook length: %lld\n", hl_ans);
    
    return 0;
}
