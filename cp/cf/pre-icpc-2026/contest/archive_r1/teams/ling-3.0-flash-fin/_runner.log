            long long ans=LLONG_MAX;
            long long mn=a[0];
            for(int r=k-1;r<n;r++){
                // l ranges from 0 to r-k+1 (0-indexed)
                // mn = min(a[0..r-k+1])
                if(r-k+1>=0){
                    mn=min(mn,a[r-k+1]); // wait, this is wrong, mn should be prefix min up to r-k+1
                }
            }
            // Let me redo:
            mn=a[0];
            for(int r=k;r<=n;r++){ // r is 1-indexed, from k to n
                // l from 1 to r-k+1, 1-indexed
                // mn_prefix[r-k+1] = min(a[1..r-k+1])
                // But I need to compute prefix min on the fly
                // Actually let me use 0-indexed
                int idx=r-1; // 0-indexed r
                // l from 0 to idx-k+1 (0-indexed)
                // I need min of a[0..idx-k+1]
                // Let me compute prefix min separately
            }
            // Clean implementation:
            vector<long long> pref_min(n);
            pref_min[0]=a[0];
            for(int i=1;i<n;i++) pref_min[i]=min(pref_min[i-1],a[i]);
            ans=LLONG_MAX;
            for(int r=k;r<=n;r++){ // r is 1-indexed
                // l from 1 to r-k+1 (1-indexed) => 0 to r-k (0-indexed)
                // pref_min[r-k] = min(a[0..r-k])
                long long cur = pref_min[r-k] + a[r-1];
                ans=min(ans,cur);
            }
            printf("%lld\n",ans);
        }
    }
    return 0;
}
