def check(d):
    n = len(d)
    dx = [0, -1, 0, 1]
    dy = [1, 0, -1, 0]
    pts = [(0, 0)]
    x, y = 0, 0
    for i in range(n):
        x += dx[i%4] * d[i]
        y += dy[i%4] * d[i]
        pts.append((x, y))
    
    for i in range(n):
        for j in range(max(0, i-5), i-1):
            s1x1, s1y1 = pts[i]; s1x2, s1y2 = pts[i+1]
            s2x1, s2y1 = pts[j]; s2x2, s2y2 = pts[j+1]
            # Check if segments intersect (non-consecutive)
            if s1x1 == s1x2 and s2y1 == s2y2:  # vert, horiz
                vx, vy1, vy2 = s1x1, min(s1y1, s1y2), max(s1y1, s1y2)
                hy, hx1, hx2 = s2y1, min(s2x1, s2x2), max(s2x1, s2x2)
                if hx1 <= vx <= hx2 and vy1 <= hy <= vy2 and j+1 != i and i+1 != j:
                    return True
            elif s1y1 == s1y2 and s2x1 == s2x2:  # horiz, vert
                hy, hx1, hx2 = s1y1, min(s1x1, s1x2), max(s1x1, s1x2)
                vx, vy1, vy2 = s2x1, min(s2y1, s2y2), max(s2y1, s2y2)
                if hx1 <= vx <= hx2 and vy1 <= hy <= vy2 and j+1 != i and i+1 != j:
                    return True
            elif s1x1 == s1x2 and s2x1 == s2x2:  # both vert
                if s1x1 == s2x1:
                    a1, b1 = min(s1y1, s1y2), max(s1y1, s1y2)
                    a2, b2 = min(s2y1, s2y2), max(s2y1, s2y2)
                    if max(a1, a2) <= min(b1, b2) and j+1 != i and i+1 != j:
                        return True
            elif s1y1 == s1y2 and s2y1 == s2y2:  # both horiz
                if s1y1 == s2y1:
                    a1, b1 = min(s1x1, s1x2), max(s1x1, s1x2)
                    a2, b2 = min(s2x1, s2x2), max(s2x1, s2x2)
                    if max(a1, a2) <= min(b1, b2) and j+1 != i and i+1 != j:
                        return True
    return False

print('Test 1:', check([2,1,1,2]))  # Yes
print('Test 2:', check([1,2,3,4]))  # No
print('Test 3:', check([1,1,1,1,1]))  # Yes
