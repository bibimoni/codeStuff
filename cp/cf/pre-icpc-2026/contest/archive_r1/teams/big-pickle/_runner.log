import subprocess, sys, time
prog = sys.argv[1]
Ns = [int(x) for x in sys.argv[2:]]
p = subprocess.Popen([prog], stdin=subprocess.PIPE, stdout=subprocess.PIPE, text=True, bufsize=1)
def rd():
    l = p.stdout.readline()
    if not l: return None
    return l.strip()
t0=time.time(); mx=0; total=0
p.stdin.write(str(len(Ns))+"\n"); p.stdin.flush()
for N in Ns:
    v=1; q=0
    while True:
        l = rd()
        if l is None: print("EOF N=%d q=%d v=%d"%(N,q,v)); sys.exit(1)
        if l.startswith('!'):
            got=int(l[2:]); 
            if got!=N: print("WRONG N=%d got=%d q=%d"%(N,got,q)); sys.exit(2)
            break
        c=l.split()[1]; q+=1
        if c=='L': ok=2*v<=N; v=2*v if ok else v
        elif c=='R': ok=2*v+1<=N; v=2*v+1 if ok else v
        else: ok=v>1; v=v//2 if ok else v
        p.stdin.write("1\n" if ok else "0\n"); p.stdin.flush()
    mx=max(mx,q); total+=q
p.stdin.close(); p.wait()
print("all ok, maxq=%d totalq=%d time=%.2fs"%(mx,total,time.time()-t0))
EOF
