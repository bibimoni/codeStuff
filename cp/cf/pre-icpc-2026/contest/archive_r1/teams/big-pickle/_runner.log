#include <bits/stdc++.h>
using namespace std;
int main(){
  mt19937_64 rng(999);
  for (int it=0; it<800; it++){
    int n = 3 + rng()%60;
    int mode = it % 4;
    long long base = 1 + rng()%20;
    printf("1\n%d\n", n);
    for (int i=0;i<n;i++){
      long long v;
      if (mode==0) v = base + (long long)(rng()%3);
      else if (mode==1) v = base + i + (long long)(rng()%2);
      else if (mode==2) v = base * (1 + (long long)(rng()%2)) + (long long)(rng()%2);
      else v = 1 + (long long)(rng()% (base+1));
      printf("%lld ", v);
    }
    printf("\n");
  }
}
