  int best=1000000;
  for(int i=0;i<n;i++)for(int j=i+2;j<n;j++){auto&A=s[i];auto&B=s[j];
   bool av=A[0]==A[2],bv=B[0]==B[2];bool hit=false;
   if(av&&bv)hit=A[0]==B[0]&&max(min(A[1],A[3]),min(B[1],B[3]))<=min(max(A[1],A[3]),max(B[1],B[3]));
   else if(!av&&!bv)hit=A[1]==B[1]&&max(min(A[0],A[2]),min(B[0],B[2]))<=min(max(A[0],A[2]),max(B[0],B[2]));
