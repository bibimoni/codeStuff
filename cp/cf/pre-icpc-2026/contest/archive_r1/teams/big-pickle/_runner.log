#include <bits/stdc++.h>
using namespace std;
int rank_of(vector<int>&g,int n,int m,vector<char>&dead){
  int V=0,E=0; vector<vector<int>> adj(n*m);
  for(int i=0;i<n*m;i++){ if(!g[i]||dead[i])continue; V++;
    int r=i/m,c=i%m;
    if(c+1<m && !dead[i+1] && g[i+1] && (g[i]&2)&&(g[i+1]&8)){E++;adj[i].push_back(i+1);adj[i+1].push_back(i);}
    if(r+1<n && !dead[i+m] && g[i+m] && (g[i]&4)&&(g[i+m]&1)){E++;adj[i].push_back(i+m);adj[i+m].push_back(i);}
  }
  vector<char>vis(n*m,0); int C=0;
  for(int i=0;i<n*m;i++){ if(!g[i]||dead[i]||vis[i])continue; C++; vector<int> st{i}; vis[i]=1;
    while(!st.empty()){int u=st.back();st.pop_back();for(int v:adj[u])if(!vis[v]){vis[v]=1;st.push_back(v);} } }
  return E-V+C;
}
int main(){int t;scanf("%d",&t);
 while(t--){int n,m;scanf("%d %d",&n,&m);int N=n*m;vector<int>g(N);
  for(auto&x:g)scanf("%d",&x);
  int q;scanf("%d",&q);vector<int>hit(q);vector<char>dead(N,0);
  for(int i=0;i<q;i++){int r,c;scanf("%d %d",&r,&c);hit[i]=(r-1)*m+c-1;dead[hit[i]]=1;}
  for(int i=0;i<q;i++){ printf("%d%c", rank_of(g,n,m,dead), i+1==q?'\n':' '); dead[hit[i]]=0; }
  if(q==0)puts("");
 }
 return 0;}
EOF
