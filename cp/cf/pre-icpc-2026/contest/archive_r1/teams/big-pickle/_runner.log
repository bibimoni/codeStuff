#include <bits/stdc++.h>
using namespace std;
typedef long long ll;
int main(int argc,char**argv){
  int mode=atoi(argv[1]); mt19937_64 rng(argc>2?atoll(argv[2]):12345);
  int T=3000; printf("%d\n",T);
  for(int it=0;it<T;it++){
    int n; ll base;
    if(mode==0){n=1+rng()%14; base=1+rng()%6;}
    else if(mode==1){n=3+rng()%60; base=1+rng()%20;}
    else if(mode==2){n=4+rng()%200; base=1+rng()%3000;}
    else {n=4+rng()%100; base=1+rng()%50;}
    printf("%d\n",n);
    for(int i=0;i<n;i++){
      ll v;
      if(mode==3) v=base+i/2+ (ll)(rng()%2);       // expanding spiral (mostly No)
      else v=base+(i/2)+(ll)(rng()%3)-(ll)(rng()%2)+(ll)(rng()%2);
      if(v<1)v=1; printf("%lld ",v);
    }
    printf("\n");
  }
}
