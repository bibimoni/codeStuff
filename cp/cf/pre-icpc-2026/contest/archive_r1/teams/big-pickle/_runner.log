                A=segs[a1];B=segs[b1]
                av=A[0]==A[2];bv=B[0]==B[2]
                hit=False
                if av and bv: hit = A[0]==B[0] and max(min(A[1],A[3]),min(B[1],B[3]))<=min(max(A[1],A[3]),max(B[1],B[3]))
                elif not av and not bv: hit = A[1]==B[1] and max(min(A[0],A[2]),min(B[0],B[2]))<=min(max(A[0],A[2]),max(B[0],B[2]))
                elif av: hit = min(A[1],A[3])<=B[1]<=max(A[1],A[3]) and min(B[0],B[2])<=A[0]<=max(B[0],B[2])
                else: hit = min(B[1],B[3])<=A[1]<=max(B[1],B[3]) and min(A[0],A[2])<=B[0]<=max(A[0],B[2])
                if hit: print("  first hit pair",a1+1,b1+1,"dist",b1-a1); break
            else: continue
            break
        shown+=1
