    tdir = m["tdir"]
    tests = sorted((f for f in os.listdir(tdir)
                    if not f.endswith(".a") and not f.endswith(".out")),
                   key=lambda s: int(s))
    with tempfile.TemporaryDirectory(prefix="judge") as td:
        bin_path = os.path.join(td, "sol")
        ok, err = compile_cpp(src, bin_path)
