    if a[0]=='-1': continue
    x=set(int(t)-1 for t in a[1:])
    good=True
    for i in range(N):
        s=st[i]^(i in x)
        for j in adj[i]: s^=(j in x)
        if s!=1: good=False;break
    ok+=good
    if not good: print('BAD',qi)
print("verified ok:",ok,"of 500")
