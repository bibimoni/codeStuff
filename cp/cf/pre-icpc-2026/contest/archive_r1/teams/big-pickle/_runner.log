#include <bits/stdc++.h>
using namespace std;
int main(){mt19937 rng(7);int T=3000;printf("%d\n",T);
 for(int it=0;it<T;it++){int n=1+rng()%5,m=1+rng()%5;
  // build a random valid config: openings chosen randomly, ensuring >=2 openings
  vector<vector<int>> g(n,vector<int>(m,0));
  for(auto&r:g)for(auto&c:r){int bits=0;for(int d=0;d<4;d++) if(rng()%2)bits|=1<<d; int pc=__builtin_popcount(bits); if(pc==1)bits|=1<<rng()%4; if(pc==0&&rng()%2)bits|=3;c=bits;}
  printf("%d %d\n",n,m);for(auto&r:g)for(auto&c:r)printf("%d ",c);printf("\n");
  // choose q distinct junctions
  vector<pair<int,int>> js; for(int i=0;i<n;i++)for(int j=0;j<m;j++) if(g[i][j])js.push_back({i+1,j+1});
  shuffle(js.begin(),js.end(),rng); int q=rng()%(js.size()+1);
  printf("%d\n",q); for(int i=0;i<q;i++)printf("%d %d\n",js[i].first,js[i].second);
 }
 return 0;}
EOF
