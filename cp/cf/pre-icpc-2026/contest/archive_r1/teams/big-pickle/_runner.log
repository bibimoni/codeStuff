#include <bits/stdc++.h>
using namespace std;
int main(int argc,char**argv){ // argv: N [N N ...]
 setvbuf(stdout,0,_IONBF,0);
 int T=argc-1; printf("%d\n",T); fflush(stdout);
 for(int t=0;t<T;t++){ unsigned long long N=strtoull(argv[t+1],0,10); unsigned long long v=1; long long q=0;
  while(true){ char op[8]; if(scanf("%7s",op)!=1) return 1;
   if(op[0]=='?'){ q++;
    if(op[2]=='L'){ if(2*v<=N){v*=2;printf("1\n");} else printf("0\n"); }
    else if(op[2]=='R'){ if(2*v+1<=N){v=2*v+1;printf("1\n");} else printf("0\n"); }
    else { if(v>1){v/=2;printf("1\n");} else printf("0\n"); }
    fflush(stdout);
   } else if(op[0]=='!'){ unsigned long long a; scanf("%llu",&a);
    if(a!=N){ printf("WRONG %s got %llu want %llu\n",argv[t+1],a,N); fflush(stdout); return 2; }
    printf("OK %s q=%lld\n",argv[t+1],q); fflush(stdout); break;
   } else return 3;
  }
 }
 return 0;}
EOF
