#include <bits/stdc++.h>
using namespace std;
int main(int argc,char**argv){
 setvbuf(stdout,0,_IONBF,0);
 int T=argc-1; printf("%d\n",T);
 for(int t=0;t<T;t++){ unsigned long long N=strtoull(argv[t+1],0,10); unsigned long long v=1; long long q=0;
  while(true){ char c0,c1; if(scanf(" %c",&c0)!=1){ fprintf(stderr,"EOF at t=%d q=%lld v=%llu\n",t,q,v); return 1; }
   if(c0=='!'){ unsigned long long a; if(scanf("%llu",&a)!=1) return 3;
    if(a!=N){ fprintf(stderr,"WRONG t=%d %s got %llu want %llu q=%lld\n",t,argv[t+1],a,N,q); return 2; }
    fprintf(stderr,"OK %s q=%lld\n",argv[t+1],q); break; }
   if(c0!='?'){ fprintf(stderr,"bad char %c\n",c0); return 3; }
   if(scanf(" %c",&c1)!=1) return 3; q++;
   if(c1=='L'){ if(2*v<=N){v*=2;printf("1\n");} else printf("0\n"); }
   else if(c1=='R'){ if(2*v+1<=N){v=2*v+1;printf("1\n");} else printf("0\n"); }
   else if(c1=='B'){ if(v>1){v/=2;printf("1\n");} else printf("0\n"); }
   else { fprintf(stderr,"bad query %c\n",c1); return 3; }
  }
 }
 return 0;}
