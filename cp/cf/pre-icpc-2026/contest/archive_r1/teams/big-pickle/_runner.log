#include <bits/stdc++.h>
using namespace std;
typedef long long ll;
int main(int argc,char**argv){
  mt19937_64 rng(atoi(argv[1]));
  int maxd=0; ll bestn=0; vector<ll> bestd;
  int ITER=200000;
  for(int it=0; it<ITER; it++){
    int n = 2 + rng()%30;
    int mx = 1 + rng()%4;
    vector<ll> d(n); for(auto&x:d) x=1+rng()%mx;
    vector<array<ll,4>> s(n); ll x=0,y=0; int dx[4]={0,-1,0,1},dy[4]={1,0,-1,0};
    for(int i=0;i<n;i++){int k=i%4;s[i]={x,y,x+dx[k]*d[i],y+dy[k]*d[i]};x+=dx[k]*d[i];y+=dy[k]*d[i];}
    int mind=1000000;
    for(int i=0;i<n;i++)for(int j=i+2;j<n;j++){auto&A=s[i];auto&B=s[j];
     bool av=A[0]==A[2],bv=B[0]==B[2];bool hit=false;
     if(av&&bv)hit=A[0]==B[0]&&max(min(A[1],A[3]),min(B[1],B[3]))<=min(max(A[1],A[3]),max(B[1],B[3]));
     else if(!av&&!bv)hit=A[1]==B[1]&&max(min(A[0],A[2]),min(B[0],B[2]))<=min(max(A[0],A[2]),max(B[0],B[2]));
     else if(av)hit=min(A[1],A[3])<=B[1]&&B[1]<=max(A[1],A[3])&&min(B[0],B[2])<=A[0]&&A[0]<=max(B[0],B[2]);
     else hit=min(B[1],B[3])<=A[1]&&A[1]<=max(B[1],B[3])&&min(A[0],A[2])<=B[0]&&B[0]<=max(A[0],A[2]);
     if(hit)mind=min(mind,j-i);}
    if(mind<1000000 && mind>maxd){maxd=mind;bestn=n;bestd=d;}
  }
  printf("max first-intersection distance = %d\ncase n=%lld d=",maxd,bestn);
  for(auto v:bestd)printf("%lld ",v); printf("\n");
}
EOF
