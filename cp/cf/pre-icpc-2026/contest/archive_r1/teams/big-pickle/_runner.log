N=3000
lines=open('bmax2.txt').read().split('\n')
M=int(lines[0].split()[1])
adj=[[] for _ in range(N)]
for i in range(M):
    u,v=map(int,lines[1+i].split()); u-=1;v-=1; adj[u].append(v); adj[v].append(u)
out=open('bmax2.out').read().split('\n')
ok=0
for qi in range(500):
    st=[int(c) for c in lines[1+M+qi].split()]
