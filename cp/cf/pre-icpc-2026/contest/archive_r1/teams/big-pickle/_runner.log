# independent rank check of A = I + adj via python GF2 elimination (slow but ok for 3000? use bitset ints)
lines=open('bmax.txt').read().split('\n')
N,M,Q=map(int,lines[0].split())
rows=[1<<i for i in range(N)]
for i in range(M):
    u,v=map(int,lines[1+i].split()); u-=1; v-=1
    rows[u]^=1<<v; rows[v]^=1<<u
rank=0
basis={}
for r in rows:
    for c in range(N-1,-1,-1):
        if (r>>c)&1:
            if c in basis: r^=basis[c]
            else: basis[c]=r; rank+=1; break
print("independent rank:",rank,"nullity:",N-rank)
