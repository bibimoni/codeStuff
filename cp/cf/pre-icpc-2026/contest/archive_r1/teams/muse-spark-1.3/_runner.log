import subprocess, random
random.seed(5)
def gen_one():
    N=random.randint(1,10)
    medges=[(u,v) for u in range(N) for v in range(u+1,N) if random.random()<0.3]
    Q=random.randint(1,5)
    qs=[''.join(random.choice('01') for _ in range(N)) for _ in range(Q)]
    inp=f"{N} {len(medges)} {Q}\n"
    for u,v in medges: inp+=f"{u+1} {v+1}\n"
    for q in qs: inp+=q+"\n"
    return N,medges,qs,inp
tests=[gen_one() for _ in range(60)]
inp="1 0 0\n"  # placeholder
# run each separately (Q varies)
bad=0
for N,medges,qs,inp in tests:
    p=subprocess.run(['/tmp/b'],input=inp,capture_output=True,text=True)
    lines=p.stdout.strip().split('\n')
    assert len(lines)==len(qs),(inp,p.stdout)
    # adjacency matrix incl self
    import itertools
    A=[[1 if i==j else 0 for j in range(N)] for i in range(N)]
    for u,v in medges: A[u][v]^=1; A[v][u]^=1
    for s,ln in zip(qs,lines):
        c=[1^(ord(ch)-48) for ch in s]
        if ln.strip()=='-1':
            # brute: exists x with Ax=c?
            found=False
            for mask in range(1<<N):
                x=[(mask>>i)&1 for i in range(N)]
                if all(sum(A[i][j]*x[j] for j in range(N))%2==c[i] for i in range(N)):
                    found=True; break
            if found: bad+=1; print("FALSE -1",N,medges,s)
        else:
            parts=list(map(int,ln.split())); K=parts[0]; xs=[v-1 for v in parts[1:]]
            assert K==len(xs),("count",inp,ln)
            x=[0]*N
            for v in xs: x[v]^=1
            if not all(sum(A[i][j]*x[j] for j in range(N))%2==c[i] for i in range(N)):
                bad+=1; print("WRONG SOL",N,medges,s,ln)
print("done bad",bad)
