import random
def solve_perm(p):
    n=len(p); r=[0]*(n+1)
    for i,x in enumerate(p): r[x]=i+1
    r.append(0)  # r[n+1]=0 ; careful: index n (0-based n) 
    # use 0-based: positions 0..n-1, p values 0-based; succ rank of x+1 or 0 if x==n-1
    q=[]
    for x in p:
        q.append(r[x+1] if x+1<n else 0)
    blocks=1
    for i in range(1,n):
        if q[i]<=q[i-1]: blocks+=1
    # construct string
    s=[0]*n; ch=0
    # assign block ids
    bid=[0]*n; b=0
    for i in range(n):
        if i>0 and q[i]<=q[i-1]: b+=1
        bid[i]=b
    for i,x in enumerate(p): s[x]=bid[i]
    return blocks,s
def suffix_array(s):
    n=len(s)
    return sorted(range(n),key=lambda i: s[i:])
random.seed(0)
bad=0
for t in range(2000):
    n=random.randint(1,50)
    p=list(range(n)); random.shuffle(p)
    blocks,s=solve_perm(p)
    if suffix_array(s)!=p:
        bad+=1; print("MISMATCH",p,s)
        if bad>3: break
print("done bad",bad)
