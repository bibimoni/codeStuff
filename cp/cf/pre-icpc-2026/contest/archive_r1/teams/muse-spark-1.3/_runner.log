import random
MOD=10**9+7
def fast(a):
    n=len(a); P=[0]*(n+1)
    for i in range(1,n+1): P[i]=P[i-1]+a[i-1]
    S=P[n]
    if S==0:
        c=sum(1 for i in range(1,n) if P[i]==0)
        return pow(2,c,MOD)
    from collections import Counter
    freq=Counter(P[1:n])
    ans=1
    for k in range(2,n+1):
        if S%k!=0: continue
        seg=S//k; prod=1
        for j in range(1,k):
            prod=prod*freq.get(j*seg,0)%MOD
            if prod==0: break
        ans=(ans+prod)%MOD
    return ans
def brute(a):
    n=len(a); S=sum(a); count=0
    for mask in range(1<<(n-1)):
        cuts=[i+1 for i in range(n-1) if mask>>i & 1]
        bounds=[0]+cuts+[n]
        sums=[sum(a[bounds[i]:bounds[i+1]]) for i in range(len(bounds)-1)]
        if all(s==sums[0] for s in sums): count+=1
    return count
random.seed(7)
bad=0
for t in range(20000):
    n=random.randint(1,8)
    a=[random.randint(-3,3) for _ in range(n)]
    f=fast(a); b=brute(a)%MOD
    if f!=b:
        bad+=1; print("MISMATCH",a,"fast",f,"brute",b)
        if bad>10: break
print("done bad",bad)
EOF
