import subprocess, random
def brute(n, a, b, s, t):
    # nodes 0..n-1 islands, n = hub; s<t (t may be n)
    adj = {i: [] for i in range(n+1)}
    for i in range(n):
        j = (i+1) % n
        adj[i].append((j, a[i])); adj[j].append((i, a[i]))
    for i in range(n):
        adj[i].append((n, b[i])); adj[n].append((i, b[i]))
    best = None
    stack = [(s, 1 << s, 0)]
    # bitmask works for n+1 <= ~12
    while stack:
        v, mask, c = stack.pop()
        if v == t:
            if best is None or c < best: best = c
            continue
        for w, co in adj[v]:
            if mask >> w & 1: continue
            stack.append((w, mask | (1 << w), c + co))
    return best
def run_prog(n, a, b, events):
    inp = f"1\n{n} {len(events)}\n{' '.join(map(str,a))}\n{' '.join(map(str,b))}\n"
    for e in events: inp += ' '.join(map(str,e)) + "\n"
    p = subprocess.run(['/tmp/l'], input=inp, capture_output=True, text=True)
    return list(map(int, p.stdout.strip().split()))
random.seed(0)
bad = 0
for trial in range(300):
    n = random.randint(2, 7)
    a = [random.randint(-3, 3) for _ in range(n)]
    b = [random.randint(-3, 3) for _ in range(n)]
    events = []
    q = random.randint(1, 12)
    aa, bb = a[:], b[:]
    for _ in range(q):
        ty = random.choice([1,1,1,2,3])
        if ty == 1:
            s = random.randint(1, n); t = random.randint(s+1, n+1)
            events.append((1, s, t))
        elif ty == 2:
            x = random.randint(1, n); w = random.randint(-3, 3)
            events.append((2, x, w))
        else:
            x = random.randint(1, n); w = random.randint(-3, 3)
            events.append((3, x, w))
    # expected via brute simulating updates
    exp = []
    aa, bb = a[:], b[:]
    for e in events:
        if e[0] == 1: exp.append(brute(n, aa, bb, e[1]-1, e[2]-1))
        elif e[0] == 2: aa[e[1]-1] = e[2]
        else: bb[e[1]-1] = e[2]
    got = run_prog(n, a, b, events)
    if got != exp:
        bad += 1
        print("MISMATCH n=", n, "a=", a, "b=", b)
        print(" events=", events)
        print(" exp=", exp)
        print(" got=", got)
        if bad > 4: break
print("done bad", bad)
