import heapq, itertools, random

def formula(a, k):
    n = len(a)
    if k == 1: return min(a)
    suf = [0]*n; suf[n-1]=a[n-1]
    for i in range(n-2,-1,-1): suf[i]=min(a[i],suf[i+1])
    ans = 10**18
    for i in range(n-k+1): ans = min(ans, a[i]+suf[i+k-1])
    return ans

def opt(a, k):
    n = len(a); M = max(a)
    start = tuple(a)
    dist = {start: 0}
    pq = [(0, start)]
    while pq:
        c, s = heapq.heappop(pq)
        if c != dist[s]: continue
        # check goal
        run = 0
        for v in s:
            run = run+1 if v==0 else 0
            if run >= k: return c
        # pay actions
        for i in range(n):
            if s[i]==0: continue
            ns = list(s); ns[i]=0; ns=tuple(ns)
            nc = c+s[i]
            if nc < dist.get(ns,10**18): dist[ns]=nc; heapq.heappush(pq,(nc,ns))
        # free actions
        for l in range(n):
            for m in range(l+1,n):
                for r in range(m+1,n):
                    v = s[l] if s[l]>=s[r] else s[r]
                    if v==s[m]: continue
                    ns = list(s); ns[m]=v; ns=tuple(ns)
                    if c < dist.get(ns,10**18): dist[ns]=c; heapq.heappush(pq,(c,ns))
    return 10**18

random.seed(1)
bad = 0
tested = 0
for trial in range(400):
    n = random.randint(1,4)
    a = [random.randint(1,3) for _ in range(n)]
    for k in range(1,n+1):
        f = formula(a,k); o = opt(a,k)
        tested += 1
        if f != o:
            bad += 1
            print("MISMATCH", a, k, "formula", f, "opt", o)
print(f"done {tested} tested, {bad} mismatches")
EOF
