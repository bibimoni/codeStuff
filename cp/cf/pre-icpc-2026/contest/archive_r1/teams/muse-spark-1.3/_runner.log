import random

def segs(d):
    # returns list of segments ((x1,y1),(x2,y2)) ; moves N,W,S,E,...
    x=y=0; out=[]
    dirs=[(0,1),(-1,0),(0,-1),(1,0)]
    for i,v in enumerate(d):
        dx,dy=dirs[i%4]
        nx,ny=x+dx*v,y+dy*v
        out.append(((x,y),(nx,ny)))
        x,y=nx,ny
    return out

def inter(s1,s2):
    (ax,ay),(bx,by)=s1; (cx,cy),(dx,dy)=s2
    # axis aligned; normalize
    if ax==bx and cx==dx: # both vertical
        if ax!=cx: return False
        return max(min(ay,by),min(cy,dy))<=min(max(ay,by),max(cy,dy))
    if ay==by and cy==dy: # both horizontal
        if ay!=cy: return False
        return max(min(ax,bx),min(cx,dx))<=min(max(ax,bx),max(cx,dx))
    # one vert one horiz
    if ax==bx: v,h=s1,s2
    else: v,h=s2,s1
    (vx,vy1),(vx2,vy2)=v; (hx1,hy),(hx2,hy2)=h
    return min(hx1,hx2)<=vx<=max(hx1,hx2) and min(vy1,vy2)<=hy<=max(vy1,vy2)

def brute(d):
    s=segs(d)
    for i in range(len(s)):
        for j in range(i):
            if j==i-1: continue
            if inter(s[i],s[j]): return True
    return False

def fast(d):
    x=d; n=len(x)
    for i in range(3,n):
        if x[i]>=x[i-2] and x[i-1]<=x[i-3]: return True
        if i>=4:
            if x[i-1]==x[i-3] and x[i]+x[i-4]>=x[i-2]: return True
        if i>=5:
            if x[i-2]>=x[i-4] and x[i]+x[i-4]>=x[i-2] and x[i-1]<=x[i-3] and x[i-1]+x[i-5]>=x[i-3] and x[i-3]>x[i-5] and x[i-2]>x[i-4]:
                return True
    return False

random.seed(3)
bad=0; N=30000
for t in range(N):
    n=random.randint(1,9)
    d=[random.randint(1,4) for _ in range(n)]
    if brute(d)!=fast(d):
        bad+=1; print("MISMATCH",d,"brute",brute(d))
        if bad>5: break
print("done",N,"bad",bad)
EOF
