            p.stdin.flush()
            p.wait(timeout=5)
            ok = (got == N)
            print(f"N={N} got={got} queries={queries} {'OK' if ok else 'FAIL'}")
            return ok
        else:
            print("BAD LINE", repr(line)); p.kill(); return False
