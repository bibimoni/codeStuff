import subprocess, random, itertools
MOD=998244353
def brute(n, edges):
    # count perms respecting fixed edges (w=1: u before v; w=2: v before u)
    cons=[]
    for u,v,w in edges:
        if w==1: cons.append((u,v))
        elif w==2: cons.append((v,u))
    c=0
    for p in itertools.permutations(range(n)):
        pos=[0]*n
        for i,x in enumerate(p): pos[x]=i
        if all(pos[a]<pos[b] for a,b in cons): c+=1
    return c
random.seed(4)
bad=0
for t in range(120):
    n=random.randint(1,7)
    # random tree via prufer
    if n==1: edges=[]
    else:
        pr=[random.randrange(n) for _ in range(n-2)]
        import collections
        deg=[1]*n
        for x in pr: deg[x]+=1
        import heapq
        leaves=[i for i in range(n) if deg[i]==1]; heapq.heapify(leaves)
        deg2=deg[:]
        edges=[]
        for x in pr:
            l=heapq.heappop(leaves)
            edges.append((l,x,random.choice([0,1,2])))
            deg2[l]-=1; deg2[x]-=1
            if deg2[x]==1: heapq.heappush(leaves,x)
        l1=heapq.heappop(leaves); l2=heapq.heappop(leaves)
        edges.append((l1,l2,random.choice([0,1,2])))
    inp=f"{n}\n"+"\n".join(f"{u+1} {v+1} {w}" for u,v,w in edges)+"\n"
    out=subprocess.run(['/tmp/e'],input=inp,capture_output=True,text=True).stdout.strip()
    exp=brute(n,edges)%MOD
    if int(out)!=exp:
        bad+=1; print("MISMATCH",n,edges,int(out),exp)
        if bad>5: break
print("done bad",bad)
