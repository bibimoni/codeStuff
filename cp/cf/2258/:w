signed main() {
  ios::sync_with_stdio(false);
  cin.tie(0);
  int tt;
  cin >> tt;
  while (tt--) {
    int n, m;
    cin >> n >> m;
    vector<int> a(n);
    vector<int> cnt(m + 1);
    for (int i = 0; i < n; i++) {
      cin >> a[i];
      cnt[a[i]] += 1;
    }

    vector<int> pre(m + 1);
    for (int i = 1; i <= m; i++) {
      pre[i] = pre[i - 1] + cnt[i];
    }

    vector<int> ans(m + 1);
    int gl = 0;

    for (int i = 1; i <= m; i++) {
      int s = 0;
      vector<int> tot(19, 0);
      for (int j = 1; j <= m / i; j++) {
        int l = i * j;
        int r = min(m, (j + 1) * i - 1);

        int non = pre[r] - pre[l - 1];
        if (non == 0) {
          continue;
        }

        s += non * j;
        for (int k = 1; k <= 18; k++) {
          int mx = (1 << k);
          if (j < mx) {
            tot[k] += non * j;
          } else if (j > mx) {
            tot[k] += non * (mx - 1);
          } else {
            tot[k] += non * (mx - 1) + (mx * i <= m ? cnt[mx * i] : 0);
          }
        }

        for (int k = 1; k <= min(m, 18); k++) {
          ans[k] = max(ans[k], tot[k]);
        }
        gl = max(gl, s);
      }       
      
    } 

    for (int i = 19; i <= m; i++) {
      ans[i] = max(ans[i], gl);
    }
    
    for (int i = 1; i <= m; i++) {
      ans[i] = max(ans[i], ans[i - 1]);
      cout << ans[i] << " \n"[i == m];
    }
  }
}
