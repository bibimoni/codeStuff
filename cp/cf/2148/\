#define int int64_t

// Computing smallest prime factor as sieve in O(nloglogn)
// Largest prime factor can be computed by removing (a[j] == 0) condition
vector<int> spf(int n) {
  n++;
  vector<int> a(n);
  a[1] = 1;
  for (int i = 2; i < n; i++) {
    if (a[i] == 0) {
      a[i] = i;
      for (int j = 2 * i; j < n; j += i) {
        if (a[j] == 0)
          a[j] = i;
      }
    }
  }
  return a;
}

signed main() {
  ios::sync_with_stdio(false);
  cin.tie(0);

  const int N = (int)2e5 + 5;
  auto mnp = spf(N);

  int tt;
  cin >> tt;
  while (tt--) {
    int n;
    cin >> n;
    vector<int> a(n);
    for (int i = 0; i < n; i++) {
      cin >> a[i];
    }

    vector<vector<int>> pa(n);
    for (int i = 0; i < n; i++) {
      int x = a[i];
      while (x != 1) {
        pa[i].push_back(mnp[x]);
      }
    }
  }
}
